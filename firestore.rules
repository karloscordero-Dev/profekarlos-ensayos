rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Reglas para la colección de intentos de ensayos de la plataforma ProfeKarlos
    match /intentos_ensayos/{intentoId} {
      // Permitir lectura a la aplicación cliente y panel docente
      allow read: if true;
      
      // Permitir creación de intentos por parte de los estudiantes con validación de campos obligatorios
      allow create: if request.resource.data.keys().hasAll(['id', 'fecha', 'ensayoId', 'nombreEstudiante', 'emailEstudiante', 'puntajePaes']);
      
      // Permitir actualización y eliminación (gestión desde el panel)
      allow update, delete: if true;
    }
  }
}
